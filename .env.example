# =============================================================================

# Indian AI Trading Bot - Environment Configuration

# Copy to .env and fill in your values before starting Docker

# =============================================================================



# Application (use "production" on VPS — triggers security validation)

ENV=development



# Database (host access when using Docker Compose — default published port is 5433)
DATABASE_URL=postgresql://trader:traderpass@localhost:5433/trading



# Redis / Celery (Compose services use redis://redis:6379 — Redis is not published to the host)
REDIS_URL=redis://localhost:6379/0



# Security (32+ characters required when ENV=production)

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars

ENCRYPTION_KEY=replace_with_32_char_encryption_key_minimum



# Production hardening (Phase 8)

ALLOW_PUBLIC_REGISTRATION=true

EXPOSE_SERVICE_REGISTRY=true

ENABLE_OPENAPI_DOCS=true

RATE_LIMIT_LOGIN_PER_MINUTE=20

RATE_LIMIT_ORDERS_PER_MINUTE=30



# CORS (comma-separated)

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost



# Angel One SmartAPI (https://smartapi.angelone.in)

# Register at Angel One developer portal and enable TOTP on your account

ANGEL_API_KEY=

ANGEL_CLIENT_CODE=

ANGEL_PASSWORD=

ANGEL_TOTP_SECRET=



# Optional network metadata required by Angel One headers

ANGEL_CLIENT_LOCAL_IP=127.0.0.1

ANGEL_CLIENT_PUBLIC_IP=127.0.0.1

ANGEL_MAC_ADDRESS=00:00:00:00:00:00



# Alert channels (Phase 8)

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASSWORD=

ALERT_EMAIL_TO=



# Frontend — leave empty in production (nginx same-origin proxy)

VITE_API_BASE=http://localhost:8000



# AI Decision Engine

AI_DECISION_THRESHOLD=75

